 }
 
+/**
+ * QF-20260904-724 / SD-LEO-INFRA-COORDINATOR-RECEIPTS-BROADCAST-CONSTRAINTS-001 FR-3: the full,
+ * ordered set of metadata keys resolveHoldProvenance() checks, exported so a drift-detection test
+ * can diff it against live metadata instead of re-deriving the list by re-reading this function.
+ * Order matches the precedence chain below exactly.
+ */
+const HOLD_REASON_KEYS = Object.freeze([
+  'requires_human_action_reason',
+  'human_action_note',
+  'human_action_reason',
+  'human_action_required',
+  'not_worker_claimable_reason',
+  'review_hold_reason',
+  'needs_coordinator_review_reason',
+  'dispatch_ineligible_reason',
+  'pilot_throwaway',
+  'deferred_by',
+]);
+
 function resolveHoldProvenance(metadata) {
   const m = metadata || {};
   // Adversarial-review W3: strip control chars (newlines/ANSI escapes) from
@@ -729,6 +748,24 @@ function resolveHoldProvenance(metadata) {
   if (canonical && !isHoldReleased(m)) {
     return { reason: canonical, set_by: s(m.requires_human_action_by), set_at: s(m.requires_human_action_at), source_key: 'requires_human_action_reason' };
   }
+  // QF-20260904-724: three siblings of the canonical requires_human_action_reason key, all the
+  // same "human must act" hold class. None has a paired set-at field in current usage, so
+  // isHoldReleased() is deliberately NOT applied to any of the three — there is nothing to
+  // compare unfenced_at against, and gating on the canonical key's own set-at field would
+  // release a hold these keys never granted release authority over.
+  const actionNote = s(m.human_action_note);
+  if (actionNote) {
+    return { reason: actionNote, set_by: null, set_at: null, source_key: 'human_action_note' };
+  }
+  const actionReason = s(m.human_action_reason);
+  if (actionReason) {
+    return { reason: actionReason, set_by: null, set_at: null, source_key: 'human_action_reason' };
+  }
+  if (m.human_action_required === true) {
+    // human_action_required is flag-shaped (no reason text of its own) — synthesize a reason
+    // the same way the pre-existing pilot_throwaway flag below does.
+    return { reason: 'human action required', set_by: null, set_at: null, source_key: 'human_action_required' };
+  }
   const notClaimable = s(m.not_worker_claimable_reason);
   if (notClaimable) {
     return { reason: notClaimable, set_by: s(m.not_worker_claimable_by) || s(m.deferred_by), set_at: s(m.not_worker_claimable_at) || s(m.deferred_at), source_key: 'not_worker_claimable_reason' };
@@ -737,6 +774,12 @@ function resolveHoldProvenance(metadata) {
