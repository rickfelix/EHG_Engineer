@@ -743,7 +743,24 @@ async function stampConstraintsBlock(supabase, row, logger = console) {
     const { resolveHoldProvenance, formatHoldProvenance } = require('../fleet/claim-eligibility.cjs');
     const lines = [];
 
-    const ratifications = Array.isArray(metadata.ratifications_cited) ? metadata.ratifications_cited : [];
+    // SECURITY (sec-receipts-exec, evidence 3483a986): resolveHoldProvenance/formatHoldProvenance
+    // already strip control chars (claim-eligibility.cjs's "Adversarial-review W3" `s()` helper),
+    // but that protection covers ONLY the Hold line -- the three fields this stamper reads
+    // directly (ratifications_cited, the solomon_* keys, forbidden_framing(s)) were rendered
+    // with no equivalent stripping. A crafted metadata value could embed a literal newline plus
+    // a forged "- Hold: ..." bullet (indistinguishable from a genuine sanitized hold line) or
+    // ANSI escape sequences (ESC[31m, erase-line, BEL) that survive into the rendered body.
+    // SAME stripping as claim-eligibility.cjs's `s()`, applied here to every field THIS
+    // function renders that resolveHoldProvenance does not already sanitize.
+    const sanitize = (v) => {
+      if (typeof v !== 'string') return null;
+      const clean = v.replace(/[\x00-\x1f\x7f]/g, ' ').trim();
+      return clean || null;
+    };
+
+    const ratifications = (Array.isArray(metadata.ratifications_cited) ? metadata.ratifications_cited : [])
+      .map((r) => sanitize(typeof r === 'string' ? r : String(r)))
+      .filter(Boolean);
     if (ratifications.length > 0) lines.push(`Ratifications: ${ratifications.join(', ')}`);
 
     const hold = resolveHoldProvenance(metadata);
@@ -752,14 +769,19 @@ async function stampConstraintsBlock(supabase, row, logger = console) {
     // Solomon-ruling text -- no single canonical field exists; these are the keys writers
     // actually use today (measured against live SD metadata at this SD's own LEAD phase).
     for (const key of ['solomon_step0_verdict', 'solomon_structural_read', 'solomon_handoff', 'solomon_amendment_applied']) {
-      const val = metadata[key];
-      if (typeof val === 'string' && val.trim()) lines.push(`Solomon ruling (${key}): ${val.trim()}`);
+      const val = sanitize(metadata[key]);
+      if (val) lines.push(`Solomon ruling (${key}): ${val}`);
     }
 
     // Forbidden framings -- no live SD carries this key today; reading it is forward-compatible
     // capacity, not a defect, while it stays empty.
-    const forbidden = metadata.forbidden_framing || metadata.forbidden_framings;
-    if (forbidden) lines.push(`Forbidden framing: ${Array.isArray(forbidden) ? forbidden.join(', ') : String(forbidden)}`);
+    const forbiddenRaw = metadata.forbidden_framing || metadata.forbidden_framings;
+    if (forbiddenRaw) {
+      const forbidden = (Array.isArray(forbiddenRaw) ? forbiddenRaw : [forbiddenRaw])
+        .map((f) => sanitize(typeof f === 'string' ? f : String(f)))
+        .filter(Boolean);
+      if (forbidden.length > 0) lines.push(`Forbidden framing: ${forbidden.join(', ')}`);
+    }
 
     const block = lines.length > 0 ? `CONSTRAINTS:\n${lines.map((l) => `- ${l}`).join('\n')}` : 'CONSTRAINTS: none recorded';
 
