   const dispatchIneligible = s(m.dispatch_ineligible_reason);
   if (dispatchIneligible) {
     return { reason: dispatchIneligible, set_by: null, set_at: null, source_key: 'dispatch_ineligible_reason' };
@@ -1025,4 +1068,4 @@ async function liveClaimWriteFenceReason(sb, sdKey, claimantSessionId = null, li
 Object.freeze(INELIGIBILITY_AXES);
 const INELIGIBILITY_AXIS_NAMES = Object.freeze(INELIGIBILITY_AXES.map((fn) => fn.name).filter(Boolean));
 
