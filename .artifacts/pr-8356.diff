 .../stamp-constraints-block.test.js           | 34 +++++++++++++++++++
 2 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/lib/coordinator/dispatch.cjs b/lib/coordinator/dispatch.cjs
index 306acf9acd..74da2627d4 100644
--- a/lib/coordinator/dispatch.cjs
